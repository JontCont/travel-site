# Copy to .env and fill in the Synology SSO (OAuth/OIDC) values from DSM SSO Server.
# The client secret is sensitive; keep .env out of git.
TRIP_OIDC_ISSUER=https://your-nas-domain/webman/sso
TRIP_OIDC_CLIENT_ID=replace-with-sso-client-id
TRIP_OIDC_CLIENT_SECRET=replace-with-sso-client-secret
TRIP_OIDC_REDIRECT_URI=https://your-travel-domain/api/auth/oidc/callback
# DSM users listed here (comma-separated) always get the admin role.
TRIP_OIDC_ADMIN_USERS=
# Optional: DSM group whose members get admin. Defaults to administrators.
TRIP_OIDC_ADMIN_GROUP=administrators
# Set to 1 only behind a reverse proxy or Cloudflare, so login rate limits use the real client IP.
TRIP_TRUST_PROXY=

# Set this to the GHCR image published by the GitHub Actions workflow.
TRIP_IMAGE=ghcr.io/your-github-owner/your-repository:latest

# AMap JavaScript API key for opening LightMap walking navigation.
AMAP_API_KEY=replace-this-with-your-amap-api-key

# Optional: separate AMap Web Service key for in-app routed distance checks.
AMAP_WEB_KEY=