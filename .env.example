# Copy to .env and replace both example values with different random codes.
TRIP_VIEW_CODE=replace-this-with-a-random-guest-code-at-least-16-chars
TRIP_ADMIN_CODE=replace-this-with-a-different-admin-code-at-least-16-chars

# Set this to the GHCR image published by the GitHub Actions workflow.
TRIP_IMAGE=ghcr.io/your-github-owner/your-repository:latest

# AMap JavaScript API key for opening LightMap walking navigation.
AMAP_API_KEY=replace-this-with-your-amap-api-key

# Optional: separate AMap Web Service key for in-app routed distance checks.
AMAP_WEB_KEY=