{
  "name": "travel-site-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @travel/web dev",
    "dev:api": "pnpm --filter @travel/api dev",
    "build": "pnpm --filter @travel/web build",
    "lint": "oxlint",
    "test": "node --test tests/*.test.mjs && pnpm --filter @travel/api test",
    "test:shared": "node --test tests/*.test.mjs",
    "test:go": "pnpm --filter @travel/api test",
    "test:all": "pnpm test",
    "start": "pnpm --filter @travel/api start",
    "docker:dev": "docker compose --env-file .env -f docker/docker-compose.dev.yml up -d",
    "docker:prod": "docker compose --env-file .env -f docker/docker-compose.prod.yml up -d",
    "docker:build": "docker build -f docker/Dockerfile --target prod -t travel-site ."
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "oxlint": "^1.81.0"
  },
  "overrides": {
    "dompurify": ">=3.4.18"
  }
}
