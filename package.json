{
  "name": "travel-site-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @travel/web dev",
    "dev:api": "pnpm --filter @travel/api dev",
    "build": "pnpm --filter @travel/web build",
    "lint": "oxlint",
    "test": "node --test tests/*.test.mjs",
    "start": "pnpm --filter @travel/api start",
    "docker:dev": "docker compose -f docker/docker-compose.dev.yml up",
    "docker:prod": "docker compose -f docker/docker-compose.prod.yml up -d",
    "docker:build": "docker build -f docker/Dockerfile --target prod -t travel-site ."
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "oxlint": "^1.81.0"
  }
}
